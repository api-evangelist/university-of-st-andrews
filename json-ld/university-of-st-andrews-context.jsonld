    "ends_at": "staandrews:endsAt",
    "links": "staandrews:links",
    "meta": "staandrews:meta",
    "institution": {
      "@id": "schema:CollegeOrUniversity",
      "@context": {
        "name": "schema:name",
        "url": "schema:url"
      }
    }
  },
  "@type": "schema:CollegeOrUniversity",
  "name": "University of St Andrews",
