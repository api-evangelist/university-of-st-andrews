{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://status.st-andrews.ac.uk/structure/component.json",
  "name": "Component",
  "description": "A system component on the University of St Andrews service status page.",
  "type": "object",
  "properties": {
    "id": { "type": "int64" },
    "state": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "parent_id": { "type": ["int64", "null"] },
    "position": { "type": "int32" },
    "links": {
      "type": "object",
      "properties": {
        "children": {
          "type": "object",
          "properties": {
            "href": { "type": "string" },
            "count": { "type": "int32" }
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "state", "name"]
}
